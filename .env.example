# Server (bind loopback when using an SSH tunnel)
SCENE3D_DATA_ROOT=/path/to/nanjing
SCENE3D_RUN_ROOT=/path/to/backend_scene3d/runs
SCENE3D_SERVICE_SECRET=
# Local authenticated gateway
SCENE3D_REMOTE_URL=http://127.0.0.1:18013
SCENE3D_AUTH_BASE=http://127.0.0.1:8005
# Optional SSH forwarding; password is stored separately using Windows DPAPI.
SCENE3D_SSH_HOST=
SCENE3D_SSH_PORT=22
SCENE3D_SSH_USER=
SCENE3D_REMOTE_PROJECT=/path/to/backend_scene3d
SCENE3D_REMOTE_PYTHON=/path/to/venv/bin/python
